index 0000000..5a32852
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/cabbit/CabbitPlugins.java
@@ -0,0 +1,339 @@
+package org.telegram.messenger.cabbit;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.text.TextUtils;
+
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.DispatchQueue;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserConfig;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+
+// Менеджер плагинов CabbitGram: установка, включение, безопасный режим и хуки событий.
+public final class CabbitPlugins {
+
+    public static volatile PluginEngine engine;   // ставит модуль приложения при старте
+
+    public static final class Entry {
+        public String id, name, version, author, description, error;
+        public File file;
+        volatile Object instance;
+
+        public boolean isLoaded() { return instance != null; }
+    }
+
+    private static final LinkedHashMap<String, Entry> plugins = new LinkedHashMap<>();
+    private static final DispatchQueue queue = new DispatchQueue("cabbitPlugins");
+    private static boolean initialized;
+    public static boolean safeMode;
+    private static final long MAX_SIZE = 1024 * 1024;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("cabbit_plugins", Activity.MODE_PRIVATE);
+    }
+
+    private static File dir() {
+        File d = new File(ApplicationLoader.getFilesDirFixed(), "plugins");
+        d.mkdirs();
+        return d;
+    }
+
+    public static boolean isEnabled(String id) { return prefs().getBoolean("enabled_" + id, true); }
+
+    public static ArrayList<Entry> list() {
+        synchronized (plugins) {
+            return new ArrayList<>(plugins.values());
+        }
+    }
+
+    public static Entry get(String id) {
+        synchronized (plugins) {
+            return plugins.get(id);
+        }
+    }
+
+    /** Один раз из главного экрана: читаем плагины и запускаем включённые. */
+    public static void init() {
+        if (initialized) return;
+        initialized = true;
+        // Безопасный режим: если приложение дважды подряд упало в первые 20 секунд — плагины не запускаем.
+        int boots = prefs().getInt("boots", 0);
+        if (boots >= 2) {
+            safeMode = true;
+            prefs().edit().putInt("boots", 0).commit();
+        } else {
+            prefs().edit().putInt("boots", boots + 1).commit();
+            AndroidUtilities.runOnUIThread(() -> prefs().edit().putInt("boots", 0).apply(), 20000);
+        }
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            NotificationCenter.getInstance(a).addObserver(observer, NotificationCenter.didReceiveNewMessages);
+        }
+        queue.postRunnable(() -> {
+            File[] files = dir().listFiles((d, n) -> n.endsWith(".plugin"));
+            if (files == null) return;
+            for (File f : files) {
+                try {
+                    Entry e = readEntry(f);
+                    synchronized (plugins) { plugins.put(e.id, e); }
+                    if (!safeMode && isEnabled(e.id)) loadNow(e);
+                } catch (Exception ex) {
+                    FileLog.e(ex);
+                }
+            }
+            notifyChanged();
+        });
+    }
+
+    public static void exitSafeMode() {
+        safeMode = false;
+        queue.postRunnable(() -> {
+            for (Entry e : list()) if (isEnabled(e.id) && !e.isLoaded()) loadNow(e);
+            notifyChanged();
+        });
+    }
+
+    private static String read(File f) throws Exception {
+        if (f.length() > MAX_SIZE) throw new Exception("Файл плагина больше 1 МБ");
+        byte[] b = new byte[(int) f.length()];
+        try (FileInputStream in = new FileInputStream(f)) {
+            int off = 0, n;
+            while (off < b.length && (n = in.read(b, off, b.length - off)) > 0) off += n;
+        }
+        return new String(b, "UTF-8");
+    }
+
+    private static Entry readEntry(File f) throws Exception {
+        PluginEngine en = engine;
+        if (en == null) throw new Exception("Движок плагинов недоступен");
+        JSONObject meta = new JSONObject(en.inspect(read(f)));
+        Entry e = new Entry();
+        e.id = meta.optString("id");
+        if (!e.id.matches("[a-zA-Z0-9_.\\-]{2,64}")) throw new Exception("Неверный id плагина: " + e.id);
+        e.name = meta.optString("name", e.id);
+        e.version = meta.optString("version", "1.0");
+        e.author = meta.optString("author", "");
+        e.description = meta.optString("description", "");
+        e.file = f;
+        return e;
+    }
+
+    private static void loadNow(Entry e) {
+        try {
+            e.instance = engine.load(e.id, read(e.file));
+            e.error = null;
+        } catch (Throwable t) {
+            FileLog.e(t);
+            e.instance = null;
+            e.error = shortError(t);
+        }
+    }
+
+    private static void unloadNow(Entry e) {
+        Object inst = e.instance;
+        e.instance = null;
+        if (inst != null) {
+            try { engine.unload(inst); } catch (Throwable t) { FileLog.e(t); }
+        }
+    }
+
+    private static String shortError(Throwable t) {
+        String m = t.getMessage();
+        if (m == null) m = t.getClass().getSimpleName();
+        String[] lines = m.trim().split("\n");
+        return lines[lines.length - 1];   // у Python последняя строка — сама ошибка
+    }
+
+    public static void setEnabled(String id, boolean enabled) {
+        prefs().edit().putBoolean("enabled_" + id, enabled).apply();
+        queue.postRunnable(() -> {
+            Entry e = get(id);
+            if (e == null) return;
+            if (enabled && !safeMode && !e.isLoaded()) loadNow(e);
+            if (!enabled) unloadNow(e);
+            notifyChanged();
+        });
+    }
+
+    public static void delete(String id) {
+        queue.postRunnable(() -> {
+            Entry e;
+            synchronized (plugins) { e = plugins.remove(id); }
+            if (e == null) return;
+            unloadNow(e);
+            e.file.delete();
+            prefs().edit().remove("enabled_" + id).apply();
+            SharedPreferences data = ApplicationLoader.applicationContext.getSharedPreferences("cabbit_plugin_data", Activity.MODE_PRIVATE);
+            SharedPreferences.Editor ed = data.edit();
+            for (String k : data.getAll().keySet()) if (k.startsWith(id + "/")) ed.remove(k);
+            ed.apply();
+            notifyChanged();
+        });
+    }
+
+    private static void notifyChanged() {
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.cabbitPluginsChanged));
+    }
+
+    // ---------- Установка из чата ----------
+    public static boolean isPluginFile(String fileName) {
+        return fileName != null && fileName.toLowerCase().endsWith(".plugin");
+    }
+
+    public static void promptInstall(Activity activity, File src) {
+        if (engine == null) {
+            BulletinFactory.global().createSimpleBulletin(org.telegram.messenger.R.raw.error, "Плагины недоступны в этой сборке").show();
+            return;
+        }
+        queue.postRunnable(() -> {
+            Entry info = null;
+            String err = null;
+            try {
+                info = readEntry(src);
+            } catch (Throwable t) {
+                FileLog.e(t);
+                err = shortError(t);
+            }
+            final Entry fi = info;
+            final String ferr = err;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (activity.isFinishing()) return;
+                if (fi == null) {
+                    new AlertDialog.Builder(activity).setTitle("Не похоже на плагин").setMessage(ferr).setPositiveButton("ОК", null).show();
+                    return;
+                }
+                boolean update = get(fi.id) != null;
+                StringBuilder msg = new StringBuilder();
+                msg.append(fi.name).append(" ").append(fi.version);
+                if (!TextUtils.isEmpty(fi.author)) msg.append("\nАвтор: ").append(fi.author);
+                if (!TextUtils.isEmpty(fi.description)) msg.append("\n\n").append(fi.description);
+                msg.append("\n\nПлагин получает полный доступ к приложению и аккаунту. Ставь только от тех, кому доверяешь.");
+                new AlertDialog.Builder(activity)
+                        .setTitle(update ? "Обновить плагин?" : "Установить плагин?")
+                        .setMessage(msg.toString())
+                        .setPositiveButton(update ? "Обновить" : "Установить", (d, w) -> install(src, fi.id))
+                        .setNegativeButton("Отмена", null)
+                        .show();
+            });
+        });
+    }
+
+    private static void install(File src, String id) {
+        queue.postRunnable(() -> {
+            String result;
+            try {
+                Entry old = get(id);
+                if (old != null) unloadNow(old);
+                File dst = new File(dir(), id + ".plugin");
+                try (FileInputStream in = new FileInputStream(src); FileOutputStream out = new FileOutputStream(dst)) {
+                    byte[] b = new byte[16384];
+                    int n;
+                    while ((n = in.read(b)) > 0) out.write(b, 0, n);
+                }
+                Entry e = readEntry(dst);
+                synchronized (plugins) { plugins.put(e.id, e); }
+                prefs().edit().putBoolean("enabled_" + e.id, true).apply();
+                if (!safeMode) loadNow(e);
+                result = e.error == null ? "Плагин «" + e.name + "» установлен" : "Установлен, но не запустился: " + e.error;
+            } catch (Throwable t) {
+                FileLog.e(t);
+                result = "Не удалось установить: " + shortError(t);
+            }
+            final String r = result;
+            notifyChanged();
+            AndroidUtilities.runOnUIThread(() -> BulletinFactory.global().createSimpleBulletin(org.telegram.messenger.R.raw.info, r).show());
+        });
+    }
+
+    // ---------- Хуки ----------
+    /** Перед отправкой текста. true — отправку отменил плагин. Может поменять текст. */
+    public static boolean onSendMessage(SendMessagesHelper.SendMessageParams p) {
+        if (p == null || TextUtils.isEmpty(p.message) || plugins.isEmpty()) return false;
+        for (Entry e : list()) {
+            Object inst = e.instance;
+            if (inst == null) continue;
+            try {
+                JSONObject arg = new JSONObject().put("text", p.message).put("dialog_id", p.peer);
+                String res = engine.event(inst, "on_send_message", arg.toString());
+                if (res == null) continue;
+                JSONObject r = new JSONObject(res);
+                if (r.optBoolean("cancel")) return true;
+                if (r.has("text")) p.message = r.getString("text");
+            } catch (Throwable t) {
+                FileLog.e(t);
+                e.error = shortError(t);
+            }
+        }
+        return TextUtils.isEmpty(p.message);
+    }
+
+    private static final NotificationCenter.NotificationCenterDelegate observer = (id, account, args) -> {
+        if (id != NotificationCenter.didReceiveNewMessages || plugins.isEmpty()) return;
+        if (args.length > 2 && args[2] instanceof Boolean && (Boolean) args[2]) return;   // отложенные не трогаем
+        @SuppressWarnings("unchecked") ArrayList<MessageObject> msgs = (ArrayList<MessageObject>) args[1];
+        final ArrayList<String> payload = new ArrayList<>();
+        for (MessageObject m : msgs) {
+            try {
+                payload.add(new JSONObject()
+                        .put("id", m.getId())
+                        .put("dialog_id", m.getDialogId())
+                        .put("from_id", m.getSenderId())
+                        .put("out", m.isOut())
+                        .put("text", m.messageText == null ? "" : m.messageText.toString())
+                        .put("account", account).toString());
+            } catch (Exception ignore) {
+            }
+        }
+        queue.postRunnable(() -> {
+            for (Entry e : list()) {
+                Object inst = e.instance;
+                if (inst == null) continue;
+                for (String p : payload) {
+                    try {
+                        engine.event(inst, "on_new_message", p);
+                    } catch (Throwable t) {
+                        FileLog.e(t);
+                        e.error = shortError(t);
+                    }
+                }
+            }
+        });
+    };
+
+    // ---------- Настройки плагина ----------
+    public static String settingsJson(Entry e) {
+        if (e == null || e.instance == null) return "[]";
+        try {
+            return engine.settings(e.instance);
+        } catch (Throwable t) {
+            FileLog.e(t);
+            e.error = shortError(t);
+            return "[]";
+        }
+    }
+
+    public static void pluginEvent(Entry e, String name, String argJson) {
+        if (e == null || e.instance == null) return;
+        queue.postRunnable(() -> {
+            try {
+                engine.event(e.instance, name, argJson);
+            } catch (Throwable t) {
+                FileLog.e(t);
+                e.error = shortError(t);
+                AndroidUtilities.runOnUIThread(() -> BulletinFactory.global().createSimpleBulletin(org.telegram.messenger.R.raw.error, e.name + ": " + e.error).show());
+            }
+        });
+    }
+}

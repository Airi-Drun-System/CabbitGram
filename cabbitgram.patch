+package org.telegram.ui;
+
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.View;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.cabbit.CabbitPluginApi;
+import org.telegram.messenger.cabbit.CabbitPlugins;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.TextCheckCell;
+import org.telegram.ui.Components.EditTextBoldCursor;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+// CabbitGram: экран одного плагина — вкл/выкл, его настройки, удаление
+public class CabbitPluginActivity extends UniversalFragment implements NotificationCenter.NotificationCenterDelegate {
+
+    private static final int ID_ENABLED = 1, ID_DELETE = 2, ID_BASE = 1000;
+    private final String pluginId;
+    private final ArrayList<JSONObject> settings = new ArrayList<>();
+
+    public CabbitPluginActivity(String pluginId) {
+        this.pluginId = pluginId;
+    }
+
+    @Override
+    public boolean onFragmentCreate() {
+        NotificationCenter.getGlobalInstance().addObserver(this, NotificationCenter.cabbitPluginsChanged);
+        return super.onFragmentCreate();
+    }
+
+    @Override
+    public void onFragmentDestroy() {
+        NotificationCenter.getGlobalInstance().removeObserver(this, NotificationCenter.cabbitPluginsChanged);
+        super.onFragmentDestroy();
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        if (id != NotificationCenter.cabbitPluginsChanged) return;
+        if (CabbitPlugins.get(pluginId) == null) finishFragment();
+        else if (listView != null) listView.adapter.update(true);
+    }
+
+    @Override
+    protected CharSequence getTitle() {
+        CabbitPlugins.Entry e = CabbitPlugins.get(pluginId);
+        return e != null ? e.name : "Плагин";
+    }
+
+    private String value(JSONObject s) {
+        String v = CabbitPluginApi.getSetting(pluginId, s.optString("key"));
+        return v;   // JSON-строка или null
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        CabbitPlugins.Entry e = CabbitPlugins.get(pluginId);
+        if (e == null) return;
+        items.add(UItem.asCheck(ID_ENABLED, "Включён").setChecked(CabbitPlugins.isEnabled(pluginId)));
+        StringBuilder info = new StringBuilder();
+        info.append("Версия ").append(e.version);
+        if (!TextUtils.isEmpty(e.author)) info.append(" · ").append(e.author);
+        if (!TextUtils.isEmpty(e.description)) info.append("\n").append(e.description);
+        if (e.error != null) info.append("\n\nОшибка: ").append(e.error);
+        items.add(UItem.asShadow(info.toString()));
+
+        settings.clear();
+        try {
+            JSONArray arr = new JSONArray(CabbitPlugins.settingsJson(e));
+            for (int i = 0; i < arr.length(); i++) settings.add(arr.getJSONObject(i));
+        } catch (Exception ignore) {
+        }
+        for (int i = 0; i < settings.size(); i++) {
+            JSONObject s = settings.get(i);
+            String type = s.optString("type"), title = s.optString("title");
+            switch (type) {
+                case "header":
+                    items.add(UItem.asHeader(title));
+                    break;
+                case "info":
+                    items.add(UItem.asShadow(s.optString("text")));
+                    break;
+                case "switch": {
+                    String v = value(s);
+                    boolean on = v != null ? "true".equals(v) : s.optBoolean("default");
+                    items.add(UItem.asCheck(ID_BASE + i, title).setChecked(on));
+                    break;
+                }
+                case "text": {
+                    String v = value(s);
+                    String shown = s.optString("default");
+                    try { if (v != null) shown = new JSONArray("[" + v + "]").getString(0); } catch (Exception ignore) {}
+                    items.add(UItem.asButton(ID_BASE + i, title, shown));
+                    break;
+                }
+                case "button":
+                    items.add(UItem.asButton(ID_BASE + i, title).accent());
+                    break;
+            }
+        }
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asButton(ID_DELETE, "Удалить плагин").red());
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        CabbitPlugins.Entry e = CabbitPlugins.get(pluginId);
+        if (e == null) return;
+        if (item.id == ID_ENABLED) {
+            boolean v = !CabbitPlugins.isEnabled(pluginId);
+            CabbitPlugins.setEnabled(pluginId, v);
+            if (view instanceof TextCheckCell) ((TextCheckCell) view).setChecked(v);
+        } else if (item.id == ID_DELETE) {
+            new AlertDialog.Builder(getParentActivity())
+                    .setTitle("Удалить плагин?")
+                    .setMessage(e.name + " и его настройки будут удалены.")
+                    .setPositiveButton("Удалить", (d, w) -> CabbitPlugins.delete(pluginId))
+                    .setNegativeButton("Отмена", null)
+                    .show();
+        } else if (item.id >= ID_BASE && item.id - ID_BASE < settings.size()) {
+            JSONObject s = settings.get(item.id - ID_BASE);
+            String key = s.optString("key");
+            switch (s.optString("type")) {
+                case "switch": {
+                    String v = value(s);
+                    boolean on = !(v != null ? "true".equals(v) : s.optBoolean("default"));
+                    CabbitPluginApi.setSetting(pluginId, key, on ? "true" : "false");
+                    if (view instanceof TextCheckCell) ((TextCheckCell) view).setChecked(on);
+                    CabbitPlugins.pluginEvent(e, "_setting_changed", JSONObject.quote(key));
+                    break;
+                }
+                case "text":
+                    editText(e, s);
+                    break;
+                case "button":
+                    CabbitPlugins.pluginEvent(e, "_button", JSONObject.quote(key));
+                    break;
+            }
+        }
+    }
+
+    private void editText(CabbitPlugins.Entry e, JSONObject s) {
+        if (getParentActivity() == null) return;
+        String key = s.optString("key");
+        EditTextBoldCursor et = new EditTextBoldCursor(getParentActivity());
+        et.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        et.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        et.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        et.setHint(s.optString("hint"));
+        String v = value(s);
+        String cur = s.optString("default");
+        try { if (v != null) cur = new JSONArray("[" + v + "]").getString(0); } catch (Exception ignore) {}
+        et.setText(cur);
+        et.setSelection(et.length());
+        et.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(8), AndroidUtilities.dp(24), AndroidUtilities.dp(8));
+        new AlertDialog.Builder(getParentActivity())
+                .setTitle(s.optString("title"))
+                .setView(et)
+                .setPositiveButton("Сохранить", (d, w) -> {
+                    CabbitPluginApi.setSetting(pluginId, key, JSONObject.quote(et.getText().toString()));
+                    CabbitPlugins.pluginEvent(e, "_setting_changed", JSONObject.quote(key));
+                    listView.adapter.update(true);
+                })
+                .setNegativeButton("Отмена", null)
+                .show();
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}

+package org.telegram.ui;
+
+import android.text.InputType;
+import android.util.TypedValue;
+import android.view.View;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.BuildConfig;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.CabbitBadges;
+import org.telegram.messenger.CabbitConfig;
+import org.telegram.messenger.CabbitUpdater;
+import org.telegram.messenger.R;
+import org.telegram.messenger.SharedConfig;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.TextCheckCell;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.EditTextBoldCursor;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+// CabbitGram: раздел собственных настроек
+public class CabbitSettingsActivity extends UniversalFragment {
+
+    private static final int ID_REFRESH = 1, ID_PROXY = 2, ID_PROXY_OFF = 3, ID_ROTATION = 4, ID_HIDE_MONEY = 5,
+            ID_HIDE_STORIES = 6, ID_HIDE_PHONE = 7, ID_SYS_FONT = 8, ID_AUTO_UPDATE = 9, ID_CHECK_UPDATE = 10,
+            ID_COPY_ID = 11, ID_SELF_BADGE = 12, ID_ADMIN_OFF = 13, ID_HEADER = 14, ID_PLUGINS = 15;
+    private boolean proxyBusy;
+    private String proxyStatus, updateStatus;
+
+    @Override
+    protected CharSequence getTitle() {
+        return "CabbitGram";
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asButton(ID_PLUGINS, "Плагины", String.valueOf(org.telegram.messenger.cabbit.CabbitPlugins.list().size())).accent());
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asHeader("Плавность"));
+        items.add(UItem.asCheck(ID_REFRESH, "Высокая частота обновления экрана").setChecked(CabbitConfig.highRefresh()));
+        items.add(UItem.asShadow("Повышает плавность интерфейса, но увеличивает расход батареи."));
+
+        items.add(UItem.asHeader("Прокси"));
+        items.add(UItem.asButton(ID_PROXY, proxyBusy ? "Ищу самый быстрый…" : "Подключить лучший прокси", proxyStatus != null ? proxyStatus : (SharedConfig.isProxyEnabled() ? "включён" : "")).accent());
+        items.add(UItem.asCheck(ID_ROTATION, "Переключаться, если прокси отвалился").setChecked(SharedConfig.proxyRotationEnabled));
+        if (SharedConfig.isProxyEnabled()) {
+            items.add(UItem.asButton(ID_PROXY_OFF, "Отключить прокси").red());
+        }
+        items.add(UItem.asShadow("Список прокси обновляется автоматически."));
+
+        items.add(UItem.asHeader("Внешний вид"));
+        items.add(UItem.asButton(ID_HEADER, "Заголовок над чатами", CabbitConfig.headerTitle()));
+        items.add(UItem.asCheck(ID_HIDE_MONEY, "Скрыть Premium, звёзды и подарки в настройках").setChecked(CabbitConfig.hideMonetization()));
+        items.add(UItem.asCheck(ID_HIDE_STORIES, "Скрыть истории над чатами").setChecked(CabbitConfig.hideStories()));
+        items.add(UItem.asCheck(ID_HIDE_PHONE, "Скрыть мой номер в настройках").setChecked(CabbitConfig.hidePhone()));
+        if (android.os.Build.VERSION.SDK_INT >= 28) {
+            items.add(UItem.asCheck(ID_SYS_FONT, "Жирный шрифт телефона вместо Roboto").setChecked(SharedConfig.useSystemBoldFont));
+        }
+        items.add(UItem.asShadow("Изменение шрифта применится после перезапуска."));
+
+        items.add(UItem.asHeader("Обновления"));
+        items.add(UItem.asCheck(ID_AUTO_UPDATE, "Проверять при запуске").setChecked(CabbitUpdater.autoCheck()));
+        items.add(UItem.asButton(ID_CHECK_UPDATE, "Проверить сейчас", updateStatus != null ? updateStatus : "сборка " + BuildConfig.CABBIT_BUILD).accent());
+
+        items.add(UItem.asHeader("Значки"));
+        items.add(UItem.asButton(ID_COPY_ID, "Скопировать мой ID", String.valueOf(getUserConfig().getClientUserId())));
+        if (CabbitBadges.isAdmin()) {
+            items.add(UItem.asButton(ID_SELF_BADGE, "Выдать значок себе"));
+            items.add(UItem.asButton(ID_ADMIN_OFF, "Выйти из режима админа").red());
+            items.add(UItem.asShadow("Выдача значков доступна в меню профиля."));
+        } else {
+            items.add(UItem.asShadow("Значки видны только пользователям CabbitGram."));
+        }
+        items.add(UItem.asShadow("CabbitGram " + BuildVars.BUILD_VERSION_STRING + " · сборка " + BuildConfig.CABBIT_BUILD + " · Vegas"));
+    }
+
+    private void toggle(View view, boolean value) {
+        if (view instanceof TextCheckCell) ((TextCheckCell) view).setChecked(value);
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        switch (item.id) {
+            case ID_REFRESH:
+                CabbitConfig.setHighRefresh(!CabbitConfig.highRefresh());
+                toggle(view, CabbitConfig.highRefresh());
+                CabbitConfig.applyRefreshRate(getParentActivity());
+                break;
+            case ID_ROTATION:
+                SharedConfig.proxyRotationEnabled = !SharedConfig.proxyRotationEnabled;
+                SharedConfig.saveConfig();
+                toggle(view, SharedConfig.proxyRotationEnabled);
+                break;
+            case ID_PLUGINS:
+                presentFragment(new CabbitPluginsActivity());
+                break;
+            case ID_HEADER:
+                showHeaderDialog();
+                break;
+            case ID_HIDE_MONEY:
+                CabbitConfig.setHideMonetization(!CabbitConfig.hideMonetization());
+                toggle(view, CabbitConfig.hideMonetization());
+                break;
+            case ID_HIDE_STORIES:
+                CabbitConfig.setHideStories(!CabbitConfig.hideStories());
+                toggle(view, CabbitConfig.hideStories());
+                break;
+            case ID_HIDE_PHONE:
+                CabbitConfig.setHidePhone(!CabbitConfig.hidePhone());
+                toggle(view, CabbitConfig.hidePhone());
+                break;
+            case ID_SYS_FONT:
+                SharedConfig.toggleUseSystemBoldFont();
+                toggle(view, SharedConfig.useSystemBoldFont);
+                break;
+            case ID_AUTO_UPDATE:
+                CabbitUpdater.setAutoCheck(!CabbitUpdater.autoCheck());
+                toggle(view, CabbitUpdater.autoCheck());
+                break;
+            case ID_CHECK_UPDATE:
+                updateStatus = "проверяю…";
+                listView.adapter.update(true);
+                CabbitUpdater.check(getParentActivity(), result -> {
+                    updateStatus = result;
+                    if (listView != null) listView.adapter.update(true);
+                });
+                break;
+            case ID_COPY_ID:
+                AndroidUtilities.addToClipboard(String.valueOf(getUserConfig().getClientUserId()));
+                BulletinFactory.of(this).createCopyBulletin("ID скопирован").show();
+                break;
+            case ID_SELF_BADGE:
+                CabbitBadges.showAdminDialog(this, getUserConfig().getClientUserId());
+                break;
+            case ID_ADMIN_OFF:
+                CabbitBadges.setAdminToken("");
+                listView.adapter.update(true);
+                break;
+            case ID_PROXY:
+                if (proxyBusy) return;
+                proxyBusy = true;
+                proxyStatus = null;
+                listView.adapter.update(true);
+                CabbitConfig.connectBestProxy(result -> {
+                    proxyBusy = false;
+                    proxyStatus = result;
+                    if (listView != null) listView.adapter.update(true);
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.info, result).show();
+                });
+                break;
+            case ID_PROXY_OFF:
+                CabbitConfig.disableProxy();
+                proxyStatus = null;
+                listView.adapter.update(true);
+                break;
+        }
+    }
+
+    private void showHeaderDialog() {
+        if (getParentActivity() == null) return;
+        EditTextBoldCursor et = new EditTextBoldCursor(getParentActivity());
+        et.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        et.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        et.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        et.setHint("CabbitGram");
+        et.setText(CabbitConfig.headerTitle());
+        et.setSelection(et.length());
+        et.setFilters(new android.text.InputFilter[]{new android.text.InputFilter.LengthFilter(24)});
+        et.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(8), AndroidUtilities.dp(24), AndroidUtilities.dp(8));
+        new AlertDialog.Builder(getParentActivity())
+                .setTitle("Заголовок над чатами")
+                .setView(et)
+                .setPositiveButton("Сохранить", (d, w) -> {
+                    CabbitConfig.setHeaderTitle(et.getText().toString());
+                    listView.adapter.update(true);
+                    if (getParentLayout() != null) getParentLayout().rebuildAllFragmentViews(false, false);
+                })
+                .setNegativeButton("Сбросить", (d, w) -> {
+                    CabbitConfig.setHeaderTitle("");
+                    listView.adapter.update(true);
+                    if (getParentLayout() != null) getParentLayout().rebuildAllFragmentViews(false, false);
+                })
+                .show();
+    }
+
+    // Скрытый вход в режим админа: долгое нажатие на «Скопировать мой ID»
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        if (item.id != ID_COPY_ID || getParentActivity() == null) return false;
+        EditTextBoldCursor et = new EditTextBoldCursor(getParentActivity());
+        et.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        et.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        et.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        et.setHint("github_pat_…");
+        et.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        et.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(8), AndroidUtilities.dp(24), AndroidUtilities.dp(8));
+        new AlertDialog.Builder(getParentActivity())
+                .setTitle("Режим админа")
+                .setMessage("Вставь GitHub-токен с доступом к репозиторию CabbitGram. Он хранится только на этом телефоне.")
+                .setView(et)
+                .setPositiveButton("Сохранить", (d, w) -> {
+                    CabbitBadges.setAdminToken(et.getText().toString());
+                    listView.adapter.update(true);
+                })
+                .setNegativeButton("Отмена", null)
+                .show();
+        return true;
+    }
+}

diff --git a/TMessagesProj_App/src/main/java/org/telegram/messenger/CabbitPythonEngine.java b/TMessagesProj_App/src/main/java/org/telegram/messenger/CabbitPythonEngine.java
new file mode 100644
index 0000000..388310d
--- /dev/null
+++ b/TMessagesProj_App/src/main/java/org/telegram/messenger/CabbitPythonEngine.java
@@ -0,0 +1,54 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+
+import com.chaquo.python.PyObject;
+import com.chaquo.python.Python;
+import com.chaquo.python.android.AndroidPlatform;
+
+import org.telegram.messenger.cabbit.PluginEngine;
+
+// Python-движок плагинов CabbitGram (Chaquopy). Python запускается только когда нужен первый плагин.
+public class CabbitPythonEngine implements PluginEngine {
+
+    private final Context context;
+    private PyObject runtime;
+
+    public CabbitPythonEngine(Context context) {
+        this.context = context.getApplicationContext();
+    }
+
+    private synchronized PyObject rt() {
+        if (runtime == null) {
+            if (!Python.isStarted()) Python.start(new AndroidPlatform(context));
+            runtime = Python.getInstance().getModule("cabbit._runtime");
+        }
+        return runtime;
+    }
+
+    @Override
+    public String inspect(String source) {
+        return rt().callAttr("inspect", source).toString();
+    }
+
+    @Override
+    public Object load(String id, String source) {
+        return rt().callAttr("load", id, source);
+    }
+
+    @Override
+    public void unload(Object plugin) {
+        rt().callAttr("unload", plugin);
+    }
+
+    @Override
+    public String event(Object plugin, String name, String argJson) {
+        PyObject r = rt().callAttr("event", plugin, name, argJson);
+        return r == null ? null : r.toString();
+    }
+
+    @Override
+    public String settings(Object plugin) {
+        return rt().callAttr("settings", plugin).toString();
+    }
+}
diff --git a/TMessagesProj_App/src/main/python/cabbit/__init__.py b/TMessagesProj_App/src/main/python/cabbit/__init__.py
new file mode 100644
index 0000000..cdfa260
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/cabbit/__init__.py
@@ -0,0 +1,148 @@
+"""CabbitGram plugin API.
+
+Минимальный плагин:
+
+    from cabbit import Plugin, toast
+
+    __plugin__ = {"id": "hello", "name": "Привет", "version": "1.0", "author": "Vegas"}
+
+    class Hello(Plugin):
+        def on_load(self):
+            toast("Плагин запущен")
+"""
+import json
+
+from java import jclass, dynamic_proxy
+
+_api = jclass("org.telegram.messenger.cabbit.CabbitPluginApi")
+_Runnable = jclass("java.lang.Runnable")
+
+__all__ = ["Plugin", "OutgoingMessage", "IncomingMessage", "header", "info", "switch", "text", "button",
+           "toast", "send_text", "my_id", "account", "run_on_ui", "java", "log"]
+
+
+class OutgoingMessage:
+    """Сообщение перед отправкой. Можно поменять text или вызвать cancel()."""
+
+    def __init__(self, text, dialog_id):
+        self.text = text
+        self.dialog_id = dialog_id
+        self.cancelled = False
+
+    def cancel(self):
+        self.cancelled = True
+
+
+class IncomingMessage:
+    """Новое сообщение (входящее или своё с другого устройства). Только для чтения."""
+
+    def __init__(self, d):
+        self.id = d.get("id")
+        self.dialog_id = d.get("dialog_id")
+        self.from_id = d.get("from_id")
+        self.out = d.get("out", False)
+        self.text = d.get("text", "")
+        self.account = d.get("account", 0)
+
+
+class Plugin:
+    """Базовый класс. Переопредели нужные методы."""
+
+    id = None  # ставит загрузчик
+
+    def on_load(self):
+        pass
+
+    def on_unload(self):
+        pass
+
+    def on_send_message(self, msg):
+        """msg: OutgoingMessage. Верни False или вызови msg.cancel(), чтобы не отправлять."""
+        pass
+
+    def on_new_message(self, msg):
+        """msg: IncomingMessage. Вызывается в фоне, для UI используй run_on_ui()."""
+        pass
+
+    def on_setting_changed(self, key):
+        pass
+
+    def on_button(self, key):
+        pass
+
+    def settings(self):
+        """Список настроек: header(), info(), switch(), text(), button()."""
+        return []
+
+    def get(self, key, default=None):
+        v = _api.getSetting(self.id, key)
+        if v is None:
+            for s in self.settings():
+                if s.get("key") == key and "default" in s:
+                    return s["default"]
+            return default
+        return json.loads(v)
+
+    def set(self, key, value):
+        _api.setSetting(self.id, key, json.dumps(value))
+
+
+def header(title):
+    return {"type": "header", "title": title}
+
+
+def info(text):
+    return {"type": "info", "text": text}
+
+
+def switch(key, title, default=False):
+    return {"type": "switch", "key": key, "title": title, "default": bool(default)}
+
+
+def text(key, title, default="", hint=""):
+    return {"type": "text", "key": key, "title": title, "default": str(default), "hint": hint}
+
+
+def button(key, title):
+    return {"type": "button", "key": key, "title": title}
+
+
+def toast(message):
+    _api.toast(str(message))
+
+
+def send_text(dialog_id, message):
+    _api.sendText(int(dialog_id), str(message))
+
+
+def my_id():
+    return int(_api.myId())
+
+
+def account():
+    return int(_api.account())
+
+
+class _Task(dynamic_proxy(_Runnable)):
+    def __init__(self, fn):
+        super().__init__()
+        self.fn = fn
+
+    def run(self):
+        try:
+            self.fn()
+        except Exception as e:
+            log("run_on_ui:", repr(e))
+
+
+def run_on_ui(fn):
+    _api.runOnUi(_Task(fn))
+
+
+def java(class_name):
+    """Любой класс приложения или Android: java("org.telegram.messenger.UserConfig")."""
+    return jclass(class_name)
+
+
+def log(*parts):
+    _api.log(" ".join(str(p) for p in parts))
diff --git a/TMessagesProj_App/src/main/python/cabbit/_runtime.py b/TMessagesProj_App/src/main/python/cabbit/_runtime.py
new file mode 100644
index 0000000..a8d9949
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/cabbit/_runtime.py
@@ -0,0 +1,67 @@
+# Загрузчик плагинов. Вызывается из CabbitPythonEngine (Java).
+import ast
+import json
+import types
+
+import cabbit
+from cabbit import Plugin, OutgoingMessage, IncomingMessage
+
+
+def inspect(source):
+    tree = ast.parse(source)
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "__plugin__" for t in node.targets):
+            meta = ast.literal_eval(node.value)
+            if not isinstance(meta, dict) or "id" not in meta:
+                raise ValueError("__plugin__ должен быть словарём с полем id")
+            return json.dumps({str(k): str(v) for k, v in meta.items()})
+    raise ValueError("В файле нет __plugin__ = {...}")
+
+
+def load(plugin_id, source):
+    mod = types.ModuleType("cabbit_plugin_" + plugin_id.replace(".", "_").replace("-", "_"))
+    mod.__file__ = plugin_id + ".plugin"
+    exec(compile(source, plugin_id + ".plugin", "exec"), mod.__dict__)
+    cls = None
+    for v in mod.__dict__.values():
+        if isinstance(v, type) and issubclass(v, Plugin) and v is not Plugin:
+            cls = v
+    if cls is None:
+        raise ValueError("Не найден класс плагина: class ИмяПлагина(Plugin)")
+    inst = cls()
+    inst.id = plugin_id
+    inst.on_load()
+    return inst
+
+
+def unload(inst):
+    inst.on_unload()
+
+
+def event(inst, name, arg_json):
+    arg = json.loads(arg_json) if arg_json else None
+    if name == "on_send_message":
+        msg = OutgoingMessage(arg["text"], arg["dialog_id"])
+        if type(inst).on_send_message is Plugin.on_send_message:
+            return None
+        res = inst.on_send_message(msg)
+        if res is False or msg.cancelled:
+            return json.dumps({"cancel": True})
+        if msg.text != arg["text"]:
+            return json.dumps({"text": "" if msg.text is None else str(msg.text)})
+        return None
+    if name == "on_new_message":
+        if type(inst).on_new_message is not Plugin.on_new_message:
+            inst.on_new_message(IncomingMessage(arg))
+        return None
+    if name == "_setting_changed":
+        inst.on_setting_changed(arg)
+        return None
+    if name == "_button":
+        inst.on_button(arg)
+        return None
+    return None
+
+
+def settings(inst):
+    return json.dumps(list(inst.settings() or []))

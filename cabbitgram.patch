@@ -0,0 +1,180 @@
+package org.telegram.messenger;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.provider.Settings;
+import android.text.TextUtils;
+
+import androidx.core.content.FileProvider;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.ui.ActionBar.AlertDialog;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+
+// CabbitGram: автообновления из GitHub Releases (тег build-N, где N = номер сборки)
+public final class CabbitUpdater {
+
+    private static final String LATEST = "https://api.github.com/repos/Airi-Drun-System/CabbitGram/releases/latest";
+    private static final long CHECK_EVERY = 6 * 60 * 60 * 1000L;
+    private static boolean busy;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("cabbitconfig", Activity.MODE_PRIVATE);
+    }
+
+    public static boolean autoCheck() { return prefs().getBoolean("auto_update", true); }
+    public static void setAutoCheck(boolean v) { prefs().edit().putBoolean("auto_update", v).apply(); }
+
+    /** Тихая проверка при запуске (не чаще раза в 6 часов). */
+    public static void checkOnStart(Activity activity) {
+        if (!autoCheck() || BuildConfig.CABBIT_BUILD <= 0) return;
+        if (System.currentTimeMillis() - prefs().getLong("update_checked", 0) < CHECK_EVERY) return;
+        check(activity, null);
+    }
+
+    /** status != null — ручная проверка из настроек, сообщает результат. */
+    public static void check(Activity activity, Utilities.Callback<String> status) {
+        if (busy) return;
+        busy = true;
+        Utilities.globalQueue.postRunnable(() -> {
+            String err = null;
+            int build = 0;
+            String body = "", apk = null;
+            try {
+                JSONObject rel = new JSONObject(get(LATEST));
+                String tag = rel.optString("tag_name", "");
+                if (tag.startsWith("build-")) build = Integer.parseInt(tag.substring(6));
+                body = rel.optString("body", "");
+                JSONArray assets = rel.optJSONArray("assets");
+                for (int i = 0; assets != null && i < assets.length(); i++) {
+                    JSONObject a = assets.getJSONObject(i);
+                    if (a.optString("name").endsWith(".apk")) apk = a.optString("browser_download_url");
+                }
+                prefs().edit().putLong("update_checked", System.currentTimeMillis()).apply();
+            } catch (Exception e) {
+                FileLog.e(e);
+                err = "Не удалось проверить обновления";
+            }
+            final int fBuild = build;
+            final String fBody = body, fApk = apk, fErr = err;
+            AndroidUtilities.runOnUIThread(() -> {
+                busy = false;
+                if (fErr != null) {
+                    if (status != null) status.run(fErr);
+                } else if (fBuild > BuildConfig.CABBIT_BUILD && fApk != null) {
+                    if (status != null) status.run("Есть сборка " + fBuild);
+                    if (activity != null && !activity.isFinishing()) showDialog(activity, fBuild, fBody, fApk);
+                } else if (status != null) {
+                    status.run("Последняя версия (сборка " + BuildConfig.CABBIT_BUILD + ")");
+                }
+            });
+        });
+    }
+
+    private static void showDialog(Activity activity, int build, String body, String apk) {
+        String msg = "Сборка " + build + " (у тебя " + BuildConfig.CABBIT_BUILD + ")";
+        if (!TextUtils.isEmpty(body)) msg += "\n\n" + body.trim();
+        new AlertDialog.Builder(activity)
+                .setTitle("Доступно обновление CabbitGram")
+                .setMessage(msg)
+                .setPositiveButton("Обновить", (d, w) -> download(activity, apk))
+                .setNegativeButton("Позже", null)
+                .show();
+    }
+
+    private static void download(Activity activity, String url) {
+        final AlertDialog progress = new AlertDialog(activity, AlertDialog.ALERT_TYPE_LOADING);
+        progress.setTitle("Скачиваю обновление");
+        progress.setCanceledOnTouchOutside(false);
+        progress.show();
+        Utilities.globalQueue.postRunnable(() -> {
+            File dir = new File(ApplicationLoader.applicationContext.getFilesDir(), "cache");
+            dir.mkdirs();
+            File out = new File(dir, "CabbitGram-update.apk");
+            boolean ok = false;
+            try {
+                HttpURLConnection c = open(url);
+                long total = c.getContentLength();
+                try (InputStream in = c.getInputStream(); FileOutputStream fo = new FileOutputStream(out)) {
+                    byte[] buf = new byte[64 * 1024];
+                    long done = 0;
+                    int n, lastP = -1;
+                    while ((n = in.read(buf)) > 0) {
+                        fo.write(buf, 0, n);
+                        done += n;
+                        int p = total > 0 ? (int) (done * 100 / total) : 0;
+                        if (p != lastP) {
+                            lastP = p;
+                            AndroidUtilities.runOnUIThread(() -> progress.setProgress(p));
+                        }
+                    }
+                }
+                ok = total <= 0 || out.length() == total;   // не ставим обрезанный файл
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+            final boolean fOk = ok;
+            AndroidUtilities.runOnUIThread(() -> {
+                try { progress.dismiss(); } catch (Exception ignore) {}
+                if (fOk) install(activity, out);
+                else new AlertDialog.Builder(activity).setTitle("CabbitGram").setMessage("Не удалось скачать обновление. Попробуй позже.").setPositiveButton("ОК", null).show();
+            });
+        });
+    }
+
+    private static void install(Activity activity, File apk) {
+        if (Build.VERSION.SDK_INT >= 26 && !activity.getPackageManager().canRequestPackageInstalls()) {
+            new AlertDialog.Builder(activity)
+                    .setTitle("Нужно разрешение")
+                    .setMessage("Разреши CabbitGram устанавливать приложения, вернись назад и нажми «Обновить» ещё раз.")
+                    .setPositiveButton("Открыть настройки", (d, w) -> {
+                        try {
+                            activity.startActivity(new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:" + ApplicationLoader.getApplicationId())));
+                        } catch (Exception e) {
+                            FileLog.e(e);
+                        }
+                    })
+                    .show();
+            prefs().edit().putLong("update_checked", 0).apply();   // при следующем запуске предложим снова
+            return;
+        }
+        try {
+            Intent i = new Intent(Intent.ACTION_VIEW);
+            i.setDataAndType(FileProvider.getUriForFile(activity, ApplicationLoader.getApplicationId() + ".provider", apk), "application/vnd.android.package-archive");
+            i.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_ACTIVITY_NEW_TASK);
+            activity.startActivity(i);
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+    }
+
+    static HttpURLConnection open(String url) throws Exception {
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        c.setConnectTimeout(10000);
+        c.setReadTimeout(20000);
+        c.setRequestProperty("User-Agent", "CabbitGram");
+        c.setInstanceFollowRedirects(true);   // GitHub отдаёт APK через редирект на тот же https
+        return c;
+    }
+
+    static String get(String url) throws Exception {
+        HttpURLConnection c = open(url);
+        c.setRequestProperty("Accept", "application/vnd.github+json");
+        try (InputStream in = c.getInputStream()) {
+            java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
+            byte[] b = new byte[8192];
+            int n;
+            while ((n = in.read(b)) > 0) bo.write(b, 0, n);
+            return bo.toString("UTF-8");
+        }
+    }
+}

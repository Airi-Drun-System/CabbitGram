+package org.telegram.ui;
+
+import android.text.TextUtils;
+import android.view.View;
+
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.cabbit.CabbitPlugins;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+// CabbitGram: список установленных плагинов
+public class CabbitPluginsActivity extends UniversalFragment implements NotificationCenter.NotificationCenterDelegate {
+
+    private static final int ID_SAFE = 1, ID_BASE = 1000;
+    private ArrayList<CabbitPlugins.Entry> entries = new ArrayList<>();
+
+    @Override
+    public boolean onFragmentCreate() {
+        NotificationCenter.getGlobalInstance().addObserver(this, NotificationCenter.cabbitPluginsChanged);
+        return super.onFragmentCreate();
+    }
+
+    @Override
+    public void onFragmentDestroy() {
+        NotificationCenter.getGlobalInstance().removeObserver(this, NotificationCenter.cabbitPluginsChanged);
+        super.onFragmentDestroy();
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        if (id == NotificationCenter.cabbitPluginsChanged && listView != null) listView.adapter.update(true);
+    }
+
+    @Override
+    protected CharSequence getTitle() {
+        return "Плагины";
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        if (CabbitPlugins.safeMode) {
+            items.add(UItem.asShadow("Безопасный режим: приложение падало при запуске, поэтому плагины отключены."));
+            items.add(UItem.asButton(ID_SAFE, "Включить плагины снова").accent());
+        }
+        entries = CabbitPlugins.list();
+        if (CabbitPlugins.engine == null) {
+            items.add(UItem.asShadow("Плагины недоступны в этой сборке."));
+            return;
+        }
+        if (!entries.isEmpty()) items.add(UItem.asHeader("Установленные"));
+        for (int i = 0; i < entries.size(); i++) {
+            CabbitPlugins.Entry e = entries.get(i);
+            String status;
+            if (!CabbitPlugins.isEnabled(e.id)) status = "выключен";
+            else if (e.error != null) status = "ошибка";
+            else if (e.isLoaded()) status = "работает";
+            else status = "не запущен";
+            items.add(UItem.asButton(ID_BASE + i, e.name + "  " + e.version, status));
+        }
+        items.add(UItem.asShadow(entries.isEmpty()
+                ? "Плагинов пока нет. Чтобы установить, открой файл .plugin в любом чате."
+                : "Чтобы установить ещё, открой файл .plugin в любом чате."));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_SAFE) {
+            CabbitPlugins.exitSafeMode();
+            listView.adapter.update(true);
+        } else if (item.id >= ID_BASE && item.id - ID_BASE < entries.size()) {
+            presentFragment(new CabbitPluginActivity(entries.get(item.id - ID_BASE).id));
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}

@@ -0,0 +1,19 @@
+package org.telegram.messenger.cabbit;
+
+// Мост к движку плагинов (Python живёт в модуле приложения, Telegram-код его не знает напрямую).
+// Все данные туда-обратно ходят строками JSON, чтобы мост был тонким.
+public interface PluginEngine {
+    /** Метаданные из __plugin__ = {...} без запуска кода плагина. */
+    String inspect(String source) throws Exception;
+
+    /** Запускает плагин и возвращает его экземпляр. */
+    Object load(String id, String source) throws Exception;
+
+    void unload(Object plugin) throws Exception;
+
+    /** Событие плагину. Возвращает JSON-ответ или null. */
+    String event(Object plugin, String name, String argJson) throws Exception;
+
+    /** Описание настроек плагина: JSON-массив. */
+    String settings(Object plugin) throws Exception;
+}

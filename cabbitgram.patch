+package org.telegram.messenger;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.os.SystemClock;
+import android.text.TextUtils;
+import android.view.Display;
+import android.view.Window;
+import android.view.WindowManager;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.utils.proxy.ProxySettings;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+
+// CabbitGram: собственные настройки клиента (раздел «CabbitGram» в настройках)
+public final class CabbitConfig {
+
+    public static final String PROXY_LIST_URL = "https://airi-drun-system.github.io/CabbitGram/proxies.json";
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("cabbitconfig", Activity.MODE_PRIVATE);
+    }
+
+    public static boolean highRefresh() { return prefs().getBoolean("high_refresh", true); }
+    public static void setHighRefresh(boolean v) { prefs().edit().putBoolean("high_refresh", v).apply(); }
+
+    public static boolean hideMonetization() { return prefs().getBoolean("hide_monetization", false); }
+    public static void setHideMonetization(boolean v) { prefs().edit().putBoolean("hide_monetization", v).apply(); }
+
+    public static String headerTitle() {
+        String t = prefs().getString("header_title", "");
+        return TextUtils.isEmpty(t) ? "CabbitGram" : t;
+    }
+    public static void setHeaderTitle(String v) { prefs().edit().putString("header_title", v == null ? "" : v.trim()).apply(); }
+
+    public static boolean hidePhone() { return prefs().getBoolean("hide_phone", false); }
+    public static void setHidePhone(boolean v) { prefs().edit().putBoolean("hide_phone", v).apply(); }
+
+    public static boolean hideStories() { return prefs().getBoolean("hide_stories", false); }
+    public static void setHideStories(boolean v) { prefs().edit().putBoolean("hide_stories", v).apply(); }
+
+    // ---------- Плавность: максимальная частота экрана (90/120/144 Гц) ----------
+    public static void applyRefreshRate(Activity activity) {
+        if (activity == null || Build.VERSION.SDK_INT < 23) return;
+        try {
+            final Window window = activity.getWindow();
+            final Display display = activity.getWindowManager().getDefaultDisplay();
+            final WindowManager.LayoutParams lp = window.getAttributes();
+            if (highRefresh()) {
+                final Display.Mode cur = display.getMode();
+                Display.Mode best = cur;
+                for (Display.Mode m : display.getSupportedModes()) {
+                    if (m.getPhysicalWidth() == cur.getPhysicalWidth() && m.getPhysicalHeight() == cur.getPhysicalHeight() && m.getRefreshRate() > best.getRefreshRate()) {
+                        best = m;
+                    }
+                }
+                lp.preferredDisplayModeId = best.getModeId();
+                lp.preferredRefreshRate = best.getRefreshRate();
+            } else {
+                lp.preferredDisplayModeId = 0;
+                lp.preferredRefreshRate = 0;
+            }
+            window.setAttributes(lp);
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    public static float maxRefreshRate(Activity activity) {
+        try {
+            float max = 60;
+            for (Display.Mode m : activity.getWindowManager().getDefaultDisplay().getSupportedModes()) max = Math.max(max, m.getRefreshRate());
+            return max;
+        } catch (Throwable e) {
+            return 60;
+        }
+    }
+
+    // ---------- Прокси одной кнопкой ----------
+    private static String nz(String s) { return s == null ? "" : s; }
+
+    public static void connectBestProxy(Utilities.Callback<String> done) {
+        Utilities.globalQueue.postRunnable(() -> {
+            final ArrayList<ProxySettings> list = new ArrayList<>();
+            try {
+                HttpURLConnection c = (HttpURLConnection) new URL(PROXY_LIST_URL + "?t=" + System.currentTimeMillis()).openConnection();
+                c.setConnectTimeout(8000);
+                c.setReadTimeout(8000);
+                StringBuilder sb = new StringBuilder();
+                try (BufferedReader r = new BufferedReader(new InputStreamReader(c.getInputStream(), "UTF-8"))) {
+                    String line;
+                    while ((line = r.readLine()) != null) sb.append(line);
+                }
+                JSONArray arr = new JSONObject(sb.toString()).getJSONArray("proxies");
+                for (int i = 0; i < arr.length(); i++) {
+                    try {
+                        Uri u = Uri.parse(arr.getString(i).replace("https://t.me/", "tg://"));
+                        String server = u.getQueryParameter("server"), port = u.getQueryParameter("port");
+                        if (TextUtils.isEmpty(server) || TextUtils.isEmpty(port)) continue;
+                        String secret = nz(u.getQueryParameter("secret"));
+                        list.add(ProxySettings.builder()
+                                .setAddress(server).setPort(Integer.parseInt(port))
+                                .setUser(nz(u.getQueryParameter("user"))).setPassword(nz(u.getQueryParameter("pass")))
+                                .setSecret(secret)
+                                .setType(TextUtils.isEmpty(secret) ? ProxySettings.Type.SOCKS5 : ProxySettings.Type.MTPROTO)
+                                .build());
+                    } catch (Exception e) {
+                        FileLog.e(e);
+                    }
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+            AndroidUtilities.runOnUIThread(() -> {
+                if (list.isEmpty()) {
+                    done.run("Список прокси пуст или недоступен");
+                } else {
+                    pingAndConnect(list, done);
+                }
+            });
+        });
+    }
+
+    private static void pingAndConnect(ArrayList<ProxySettings> list, Utilities.Callback<String> done) {
+        final int[] left = {list.size()};
+        final boolean[] finished = {false};
+        final SharedConfig.ProxyInfo[] best = {null};
+        final Runnable finish = () -> {
+            if (finished[0]) return;
+            finished[0] = true;
+            SharedConfig.saveProxyList();
+            if (best[0] == null) {
+                done.run("Ни один прокси сейчас не отвечает");
+                return;
+            }
+            SharedConfig.currentProxy = best[0];
+            SharedPreferences.Editor ed = MessagesController.getGlobalMainSettings().edit();
+            best[0].settings.toSharedPreferences(ed);
+            ed.putBoolean("proxy_enabled", true);
+            ed.commit();
+            SharedConfig.proxyRotationEnabled = true;   // если прокси отвалится — Telegram сам переключится на следующий из списка
+            SharedConfig.saveConfig();
+            ConnectionsManager.setProxySettings(true, best[0].settings);
+            NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.proxySettingsChanged);
+            done.run("Подключено: " + best[0].settings.getAddress() + " · " + best[0].ping + " мс");
+        };
+        for (ProxySettings s : list) {
+            final SharedConfig.ProxyInfo info = SharedConfig.addProxy(new SharedConfig.ProxyInfo(s));
+            info.checking = true;
+            long req = ConnectionsManager.getInstance(UserConfig.selectedAccount).checkProxy(s, time -> AndroidUtilities.runOnUIThread(() -> {
+                info.checking = false;
+                info.availableCheckTime = SystemClock.elapsedRealtime();
+                if (time > 0) {
+                    info.ping = time;
+                    info.available = true;
+                    if (best[0] == null || time < best[0].ping) best[0] = info;
+                } else {
+                    info.available = false;
+                }
+                if (--left[0] <= 0) finish.run();
+            }));
+            if (req == 0 && s.getType() != ProxySettings.Type.WEB) {
+                info.checking = false;
+                left[0]--;
+            }
+        }
+        if (left[0] <= 0) finish.run();
+        AndroidUtilities.runOnUIThread(finish, 12000);   // не ждём вечно медленные прокси
+    }
+
+    public static void disableProxy() {
+        SharedPreferences.Editor ed = MessagesController.getGlobalMainSettings().edit();
+        ed.putBoolean("proxy_enabled", false);
+        ed.commit();
+        if (SharedConfig.currentProxy != null) {
+            ConnectionsManager.setProxySettings(false, SharedConfig.currentProxy.settings);
+        }
+        NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.proxySettingsChanged);
+    }
+}

+++ b/TMessagesProj/src/main/java/org/telegram/messenger/CabbitBadges.java
@@ -0,0 +1,253 @@
+package org.telegram.messenger;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.graphics.Paint;
+import android.graphics.drawable.Drawable;
+import android.text.SpannableStringBuilder;
+import android.text.Spanned;
+import android.text.TextUtils;
+import android.util.Base64;
+
+import androidx.core.content.ContextCompat;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.ColoredImageSpan;
+
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.util.HashMap;
+
+// CabbitGram: значки у ника. Список лежит в репозитории (badges.json), видят его только пользователи CabbitGram.
+// Формат: {"dev":[id],"admin":[id],"idea":[id],"supporter":[id],"titles":{"id":"текст"}}. Выдаёт админ из профиля человека (нужен GitHub-токен, вводится в настройках).
+public final class CabbitBadges {
+
+    public static final int NONE = 0, DEV = 1, ADMIN = 2, IDEA = 3, SUPPORTER = 4;
+    private static final String[] KEYS = {null, "dev", "admin", "idea", "supporter"};   // порядок = приоритет
+    private static final String PUBLIC_URL = "https://airi-drun-system.github.io/CabbitGram/badges.json";
+    private static final String API_URL = "https://api.github.com/repos/Airi-Drun-System/CabbitGram/contents/badges.json";
+    private static final long REFRESH_EVERY = 60 * 60 * 1000L;
+
+    private static final String[] DEFAULT_TITLES = {null, "Разработчик CabbitGram", "Администратор CabbitGram", "Автор идей CabbitGram", "Поддержал CabbitGram"};
+
+    private static volatile HashMap<Long, Integer> map;
+    private static volatile HashMap<Long, String> titles = new HashMap<>();
+    private static long lastFetch;
+    private static boolean fetching;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("cabbitconfig", Activity.MODE_PRIVATE);
+    }
+
+    public static String adminToken() { return prefs().getString("admin_token", ""); }
+    public static void setAdminToken(String t) { prefs().edit().putString("admin_token", t == null ? "" : t.trim()).apply(); }
+    public static boolean isAdmin() { return !TextUtils.isEmpty(adminToken()); }
+
+    public static int get(long userId) {
+        if (map == null) map = parse(prefs().getString("badges_json", "{}"));
+        refreshIfNeeded();
+        Integer v = map.get(userId);
+        return v == null ? NONE : v;
+    }
+
+    /** Титул: свой текст, если задан, иначе стандартный по значку. null — нет ни того, ни другого. */
+    public static String title(long userId) {
+        int b = get(userId);
+        String t = titles.get(userId);
+        if (!TextUtils.isEmpty(t)) return t;
+        return b == NONE ? null : DEFAULT_TITLES[b];
+    }
+
+    /** Строка статуса в профиле + титул через точку. */
+    public static CharSequence withTitle(CharSequence status, long userId) {
+        String t = userId > 0 ? title(userId) : null;
+        if (t == null) return status;
+        return TextUtils.isEmpty(status) ? t : status + " · " + t;
+    }
+
+    /** Имя + значок картинкой в конце. Только для отображения, сам текст имени не меняется. */
+    public static CharSequence withBadge(CharSequence name, long userId, Paint paint) {
+        if (name == null || userId <= 0) return name;
+        int b = get(userId);
+        if (b == NONE) return name;
+        Drawable d = ContextCompat.getDrawable(ApplicationLoader.applicationContext, b == DEV ? R.drawable.cabbit_badge_dev : b == ADMIN ? R.drawable.cabbit_badge_admin : b == IDEA ? R.drawable.cabbit_badge_idea : R.drawable.cabbit_badge_sup);
+        if (d == null) return name;
+        ColoredImageSpan span = new ColoredImageSpan(d.mutate(), ColoredImageSpan.ALIGN_CENTER);
+        span.recolorDrawable = false;   // значки всегда в своих цветах (глифы белые)
+        span.setSize(paint != null ? Math.round(paint.getTextSize() * 1.1f) : AndroidUtilities.dp(18));
+        SpannableStringBuilder sb = new SpannableStringBuilder(name).append(" ⁠");
+        sb.setSpan(span, sb.length() - 1, sb.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        return sb;
+    }
+
+    private static HashMap<Long, Integer> parse(String json) {
+        HashMap<Long, Integer> m = new HashMap<>();
+        HashMap<Long, String> tt = new HashMap<>();
+        try {
+            JSONObject o = new JSONObject(json);
+            JSONObject to = o.optJSONObject("titles");
+            if (to != null) {
+                for (java.util.Iterator<String> it = to.keys(); it.hasNext(); ) {
+                    String k = it.next();
+                    try { tt.put(Long.parseLong(k), to.getString(k)); } catch (Exception ignore) {}
+                }
+            }
+            for (int t = 1; t < KEYS.length; t++) {
+                JSONArray a = o.optJSONArray(KEYS[t]);
+                for (int i = 0; a != null && i < a.length(); i++) {
+                    if (!m.containsKey(a.getLong(i))) m.put(a.getLong(i), t);   // dev > admin > idea > supporter
+                }
+            }
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+        titles = tt;
+        return m;
+    }
+
+    private static void apply(String json) {
+        map = parse(json);
+        prefs().edit().putString("badges_json", json).apply();
+        AndroidUtilities.runOnUIThread(() -> {
+            for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+                if (UserConfig.getInstance(a).isClientActivated()) {
+                    NotificationCenter.getInstance(a).postNotificationName(NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_NAME);
+                }
+            }
+        });
+    }
+
+    private static void refreshIfNeeded() {
+        if (fetching || System.currentTimeMillis() - lastFetch < REFRESH_EVERY) return;
+        fetching = true;
+        lastFetch = System.currentTimeMillis();
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                String json = CabbitUpdater.get(PUBLIC_URL + "?t=" + System.currentTimeMillis());
+                new JSONObject(json);   // мусор вместо JSON не сохраняем
+                apply(json);
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+            fetching = false;
+        });
+    }
+
+    // ---------- Админ: выдать / забрать ----------
+    public static void showAdminDialog(BaseFragment fragment, long userId) {
+        if (fragment.getParentActivity() == null) return;
+        new AlertDialog.Builder(fragment.getParentActivity())
+                .setTitle("Значок CabbitGram")
+                .setItems(new CharSequence[]{"Разработчик", "Администратор", "Автор идей", "Поддержал проект", "Свой титул", "Забрать значок"}, (d, which) -> {
+                    Utilities.Callback<String> done = result -> BulletinFactory.of(fragment).createSimpleBulletin(R.raw.info, result).show();
+                    if (which == 4) showTitleDialog(fragment, userId, done);
+                    else set(userId, which < 4 ? which + 1 : NONE, done);
+                })
+                .show();
+    }
+
+    private static void showTitleDialog(BaseFragment fragment, long userId, Utilities.Callback<String> done) {
+        org.telegram.ui.Components.EditTextBoldCursor et = new org.telegram.ui.Components.EditTextBoldCursor(fragment.getParentActivity());
+        et.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 16);
+        et.setTextColor(org.telegram.ui.ActionBar.Theme.getColor(org.telegram.ui.ActionBar.Theme.key_dialogTextBlack));
+        et.setHintTextColor(org.telegram.ui.ActionBar.Theme.getColor(org.telegram.ui.ActionBar.Theme.key_dialogTextHint));
+        et.setHint("Например: Тестер");
+        et.setFilters(new android.text.InputFilter[]{new android.text.InputFilter.LengthFilter(32)});
+        String cur = titles.get(userId);
+        if (cur != null) et.setText(cur);
+        et.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(8), AndroidUtilities.dp(24), AndroidUtilities.dp(8));
+        new AlertDialog.Builder(fragment.getParentActivity())
+                .setTitle("Титул")
+                .setMessage("Показывается под ником в профиле. Пусто — стандартный по значку.")
+                .setView(et)
+                .setPositiveButton("Сохранить", (d, w) -> setTitle(userId, et.getText().toString().trim(), done))
+                .setNegativeButton("Отмена", null)
+                .show();
+    }
+
+    public static void setTitle(long userId, String title, Utilities.Callback<String> done) {
+        edit(data -> {
+            JSONObject t = data.optJSONObject("titles");
+            if (t == null) t = new JSONObject();
+            if (TextUtils.isEmpty(title)) t.remove(String.valueOf(userId)); else t.put(String.valueOf(userId), title);
+            data.put("titles", t);
+        }, "Титул для " + userId, TextUtils.isEmpty(title) ? "Титул сброшен" : "Титул сохранён", done);
+    }
+
+    private interface Mutator { void apply(JSONObject data) throws Exception; }
+
+    public static void set(long userId, int badge, Utilities.Callback<String> done) {
+        edit(data -> {
+            for (int t = 1; t < KEYS.length; t++) {
+                JSONArray a = data.optJSONArray(KEYS[t]), n = new JSONArray();
+                for (int i = 0; a != null && i < a.length(); i++) if (a.getLong(i) != userId) n.put(a.getLong(i));
+                if (t == badge) n.put(userId);
+                data.put(KEYS[t], n);
+            }
+        }, (badge == NONE ? "Забрать значок " : "Значок " + KEYS[badge] + " для ") + userId,
+                badge == NONE ? "Значок забран" : "Значок выдан. У остальных появится в течение часа", done);
+    }
+
+    private static void edit(Mutator mutator, String commitMessage, String okText, Utilities.Callback<String> done) {
+        final String token = adminToken();
+        Utilities.globalQueue.postRunnable(() -> {
+            String result;
+            try {
+                // берём свежий файл через API (Pages может отставать), чтобы не затереть чужие правки
+                HttpURLConnection g = CabbitUpdater.open(API_URL + "?t=" + System.currentTimeMillis());
+                g.setRequestProperty("Authorization", "Bearer " + token);
+                g.setRequestProperty("Accept", "application/vnd.github+json");
+                String sha = null;
+                JSONObject data = new JSONObject();
+                if (g.getResponseCode() == 200) {
+                    JSONObject f = new JSONObject(readAll(g));
+                    sha = f.getString("sha");
+                    data = new JSONObject(new String(Base64.decode(f.getString("content"), Base64.DEFAULT), "UTF-8"));
+                } else if (g.getResponseCode() != 404) {
+                    throw new Exception("GitHub " + g.getResponseCode());
+                }
+                mutator.apply(data);
+                String json = data.toString(2);
+                JSONObject body = new JSONObject()
+                        .put("message", commitMessage)
+                        .put("content", Base64.encodeToString(json.getBytes("UTF-8"), Base64.NO_WRAP));
+                if (sha != null) body.put("sha", sha);
+                HttpURLConnection p = CabbitUpdater.open(API_URL);
+                p.setRequestMethod("PUT");
+                p.setDoOutput(true);
+                p.setRequestProperty("Authorization", "Bearer " + token);
+                p.setRequestProperty("Accept", "application/vnd.github+json");
+                p.setRequestProperty("Content-Type", "application/json");
+                try (OutputStream os = p.getOutputStream()) { os.write(body.toString().getBytes("UTF-8")); }
+                int code = p.getResponseCode();
+                if (code == 200 || code == 201) {
+                    apply(json);
+                    result = okText;
+                } else if (code == 401 || code == 403) {
+                    result = "GitHub не принял токен. Проверь его в настройках CabbitGram";
+                } else {
+                    result = "Ошибка GitHub: " + code;
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+                result = "Не получилось: нет связи с GitHub";
+            }
+            final String r = result;
+            AndroidUtilities.runOnUIThread(() -> done.run(r));
+        });
+    }
+
+    private static String readAll(HttpURLConnection c) throws Exception {
+        try (java.io.InputStream in = c.getInputStream()) {
+            java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
+            byte[] b = new byte[8192];
+            int n;
+            while ((n = in.read(b)) > 0) bo.write(b, 0, n);
+            return bo.toString("UTF-8");
+        }
+    }
+}

+package org.telegram.messenger.cabbit;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserConfig;
+import org.telegram.ui.Components.BulletinFactory;
+
+// Функции, которые Python-модуль cabbit вызывает у приложения. Имена не меняются R8 (см. proguard-rules).
+public final class CabbitPluginApi {
+
+    private static SharedPreferences data() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("cabbit_plugin_data", Activity.MODE_PRIVATE);
+    }
+
+    public static String getSetting(String pluginId, String key) {
+        return data().getString(pluginId + "/" + key, null);
+    }
+
+    public static void setSetting(String pluginId, String key, String json) {
+        data().edit().putString(pluginId + "/" + key, json).apply();
+    }
+
+    public static void toast(String text) {
+        AndroidUtilities.runOnUIThread(() -> BulletinFactory.global().createSimpleBulletin(org.telegram.messenger.R.raw.info, text).show());
+    }
+
+    public static void sendText(long dialogId, String text) {
+        final int account = UserConfig.selectedAccount;
+        AndroidUtilities.runOnUIThread(() -> SendMessagesHelper.getInstance(account).sendMessage(SendMessagesHelper.SendMessageParams.of(text, dialogId)));
+    }
+
+    public static int account() {
+        return UserConfig.selectedAccount;
+    }
+
+    public static long myId() {
+        return UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId();
+    }
+
+    public static void runOnUi(Runnable r) {
+        AndroidUtilities.runOnUIThread(r);
+    }
+
+    public static void log(String text) {
+        FileLog.d("[plugin] " + text);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/cabbit/CabbitPlugins.java b/TMessagesProj/src/main/java/org/telegram/messenger/cabbit/CabbitPlugins.java
